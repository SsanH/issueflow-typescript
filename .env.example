NODE_ENV=development

# Postgres (matches compose.yml defaults)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=issueflow
DB_PASSWORD=issueflow
DB_DATABASE=issueflow

# JWT (HS256). Use a long random secret in any non-dev environment.
JWT_SECRET=change-me-in-production-use-a-long-random-secret
JWT_EXPIRES_IN=3600

# Auto-escalation cron (D19 — read at runtime, not decorator-time).
# Default applied by EscalationService if unset: CronExpression.EVERY_5_MINUTES.
# Examples: "*/5 * * * *" (every 5 min), "* * * * *" (every minute, for demos).
ESCALATION_CRON=

# Attachment upload directory (D9).
UPLOAD_DIR=./uploads
